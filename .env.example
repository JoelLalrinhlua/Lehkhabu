# ── Database (Supabase PostgreSQL) ────────────────
DATABASE_URL=postgresql+asyncpg://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
SYNC_DATABASE_URL_OVERRIDE=postgresql+psycopg2://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# MINIMUM 32 characters. The app will refuse to start if this is the placeholder.
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Auth security settings ────────────────────────
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ENFORCE_EMAIL_VERIFICATION=False

# ── Frontend URL (used in verification/reset email links) ────
FRONTEND_URL=http://localhost:5173

# ── SMTP (optional — leave blank to use console logging in dev) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=YourApp

# ── Supabase ─────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
# WARNING: SERVICE_ROLE_KEY bypasses RLS — server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Razorpay ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Frontend VITE_ env (bundled into browser-visible JS) ─────
# RULE: ONLY add keys here that are explicitly designed to be public.
# NEVER add VITE_SUPABASE_SERVICE_ROLE_KEY — that would leak it to all users.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── AI (Phase 2) ─────────────────────────────────
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=lehkhabu-books
